---
import Icon from './Icon.astro';
import type { IconName } from '../types/icons';

type Variant =
  'hero' | 'about' | 'contacts' | 'projects' | 'experience' | 'education';

type DecorItem = {
  icon: IconName;
  x: number;
  y: number;
  size: number;
  delay: number;
  duration: number;
  rotate: number;
  pair?: number;
};

const { variant } = Astro.props as {
  variant: Variant;
};

const projectTechnologyIcons: IconName[] = [
  'react',
  'typescript',
  'redux',
  'nextjs',
  'smartphone',
  'react-query',
  'react-router',
  'nodejs',
  'layers',
  'tailwind',
  'git',
  'docker',
  'postgresql',
  'javascript',
  'html5',
  'css3',
  'link',
  'express',
  'redis',
  'jest',
  'expo',
  'firebase',
  'vite',
  'sass',
  'graphql',
  'apollo',
];

const PROJECT_FALL_DURATION = 100;

const PROJECT_ICONS_COUNT = 48;
const PROJECT_LANES_COUNT = 24;

const projectDecor: DecorItem[] = Array.from(
  { length: PROJECT_ICONS_COUNT },
  (_, index) => {
    const lane = index % PROJECT_LANES_COUNT;
    const row = Math.floor(index / PROJECT_LANES_COUNT);

    const phaseIndex = (index * 17) % PROJECT_ICONS_COUNT;

    const phase = phaseIndex / PROJECT_ICONS_COUNT;

    const laneStep = 92 / (PROJECT_LANES_COUNT - 1);

    const baseX = 4 + lane * laneStep;

    const horizontalOffset = row === 0 ? -0.65 : 0.65;

    return {
      icon: projectTechnologyIcons[index % projectTechnologyIcons.length],

      x: Math.min(97, Math.max(3, baseX + horizontalOffset)),

      y: -10,

      size: 32 + ((index * 7) % 10),

      delay: -(phase * PROJECT_FALL_DURATION),

      duration: PROJECT_FALL_DURATION,

      rotate: -12 + ((index * 11) % 25),
    };
  }
);

