---

<div
  class:list={['section-decor', `section-decor--${variant}`]}
  aria-hidden="true"
>
  {
    sets[variant].map((item) => (
      <span
        class="section-decor__item"
        style={`
          --x: ${item.x}%;
          --y: ${item.y}%;
          --icon-size: ${item.size}px;
          --delay: ${item.delay}s;
          --duration: ${item.duration}s;
          --rotate: ${item.rotate}deg;
          --pair: ${item.pair ?? 0};
          --pair-delay: ${-((item.pair ?? 0) * 2)}s;
        `}
      >
        <Icon name={item.icon} size={item.size} />
      </span>
    ))
  }
</div>
